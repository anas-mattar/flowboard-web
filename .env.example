# Copy this file to .env.local for local development (real .env* files are gitignored).
# Server-only variable — read inside src/lib/api/health-client.ts, never exposed to the
# browser (no NEXT_PUBLIC prefix, ever — see docs/rulebooks/frontend-rules.md Data Flow).
FLOWBOARD_API_URL=http://localhost:5111

# specs/008-realtime-sync/plan.md ADR-33: the ONE sanctioned NEXT_PUBLIC_* exception
# (frontend-rules.md Data Flow) — the browser connects directly to this hub URL with a
# short-lived, board-scoped token (never the backend session JWT). Read only inside
# src/lib/realtime/use-board-realtime.ts, never in a component.
NEXT_PUBLIC_FLOWBOARD_HUB_URL=http://localhost:5111/hubs/board

# NextAuth (ADR-8, plan.md). Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-a-generated-secret
NEXTAUTH_URL=http://localhost:3000
